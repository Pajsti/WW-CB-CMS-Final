---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site-settings');
const s = settings?.data;

const articles = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const fmtDate = (d: Date) => d.toLocaleDateString('cs-CZ', { year:'numeric', month:'short', day:'numeric' });

// Rychle odkazy - ktere jsou aktivni
const quickLinks = [
  s?.showKanal      && { href:'/kdy-tece-kanal', i18n:'nav.canal',   cs:'Kanál' },
  s?.showKalendar   && { href:'/kalendar',        i18n:'nav.kal',    cs:'Kalendář' },
  s?.showLiveTV     && { href:'/live-tv',          i18n:'aside.live', cs:'Live výsledky' },
  s?.showRaceOffice && { href:'/race-office',      i18n:'aside.race', cs:'Race Office' },
  s?.showOfficialDocs && { href:'/official-documents', i18n:'aside.docs', cs:'Dokumenty' },
  s?.showSponsors   && { href:'/sponsors',         i18n:'aside.sponsors', cs:'Sponzoři' },
].filter(Boolean) as { href:string; i18n:string; cs:string }[];

const showAside = s?.showQuickLinks && quickLinks.length > 0;
---

<Layout title="WW-CB — Ahoj">
  <section class="hero" style={showAside ? '' : 'display:block;'}>
    <div class="hero-left card" style={showAside ? '' : 'max-width:100%;'}>
      <div class="kicker" data-i18n="hero.kicker">Oficiální stránky</div>
      <h2 data-i18n="hero.title">Divoká voda — ČB</h2>
      <p class="muted" data-i18n="hero.lead">Aktuality, galerie, program a live výsledky.</p>

      <div class="features" role="list" style={showAside ? '' : 'grid-template-columns:repeat(auto-fit,minmax(260px,1fr));'}>
        <div class="feature-card card" role="listitem">
          <strong data-i18n="feat.news">Aktuality</strong>
          <div class="muted" data-i18n="feat.news-desc">Novinky, reporty a články z akcí.</div>
          <div style="margin-top:auto"><a href="/media" class="btn" data-i18n="feat.read">Číst</a></div>
        </div>
        <div class="feature-card card">
          <strong data-i18n="feat.gallery">Fotogalerie</strong>
          <div class="muted" data-i18n="feat.gallery-desc">Fotky ze závodů a tréninků.</div>
          <div style="margin-top:auto"><a href="/fotogalerie" class="btn" data-i18n="feat.open">Otevřít</a></div>
        </div>
        <div class="feature-card card">
          <strong data-i18n="feat.schedule">Harmonogram</strong>
          <div class="muted" data-i18n="feat.schedule-desc">Program závodních dnů a startovní listiny.</div>
          <div style="margin-top:auto"><a href="/schedule" class="btn" data-i18n="feat.view">Zobrazit</a></div>
        </div>
      </div>
    </div>

    {showAside && (
      <aside class="card">
        <h3 data-i18n="aside.quick">Rychlé odkazy</h3>
        <div class="quicklist">
          {quickLinks.map(link => (
            <a href={link.href} data-i18n={link.i18n}>{link.cs}</a>
          ))}
        </div>
      </aside>
    )}
  </section>

  {s?.showLatestNews && articles.length > 0 && (
    <section style="margin-top:20px" class="card">
      <h3 data-i18n="news.title">Nejnovější</h3>
      <div id="newsCarousel">
        <div class="news-carousel">
          {articles.map((art, i) => (
            <div class={`carousel-item ${i === 0 ? 'active' : ''}`} data-index={i}>
              <a href={`/article/${art.slug}`}>
                <img src={art.data.image} alt={art.data.title}>
                <div class="carousel-item-content">
                  <h3>{art.data.title}</h3>
                  <p>{art.data.excerpt}</p>
                  <div class="date-pill">{fmtDate(art.data.date)}</div>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div class="carousel-dots">
          {articles.map((_, i) => (
            <div class={`dot ${i === 0 ? 'active' : ''}`} data-index={i}></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {s?.showLatestNews && articles.length === 0 && (
    <div class="card" style="margin-top:20px;padding:40px;text-align:center;color:var(--muted);">
      <p style="margin:0;">Zatím žádné články.</p>
    </div>
  )}
</Layout>

<script>
  var cur = 0, timer: ReturnType<typeof setInterval> | null = null;
  var items = document.querySelectorAll('.carousel-item');
  var dots = document.querySelectorAll('.dot');

  function go(i: number) {
    if (!items[cur]) return;
    items[cur].classList.add('prev');
    items[cur].classList.remove('active');
    var p = cur;
    setTimeout(function() { items[p]?.classList.remove('prev'); }, 500);
    cur = i;
    items[cur].classList.add('active');
    dots.forEach(function(d, j) { d.classList.toggle('active', j === cur); });
  }

  function start() {
    if (timer) clearInterval(timer);
    if (items.length > 1) timer = setInterval(function() { go((cur + 1) % items.length); }, 5000);
  }

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      go(parseInt((dot as HTMLElement).dataset.index || '0'));
      start();
    });
  });

  start();
  document.addEventListener('visibilitychange', function() {
    document.hidden ? (timer && clearInterval(timer)) : start();
  });
</script>
