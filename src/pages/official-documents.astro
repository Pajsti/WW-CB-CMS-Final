---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const docs = (await getCollection('documents')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title, 'cs')
);

function getIcon(file: string) {
  const ext = file.split('.').pop()?.toLowerCase();
  if (ext === 'pdf') return 'PDF';
  if (['doc','docx'].includes(ext||'')) return 'DOC';
  if (['xls','xlsx'].includes(ext||'')) return 'XLS';
  if (['zip','rar'].includes(ext||'')) return 'ZIP';
  return 'FILE';
}

function getColor(file: string) {
  const ext = file.split('.').pop()?.toLowerCase();
  if (ext === 'pdf') return '#ef4444';
  if (['doc','docx'].includes(ext||'')) return '#3b82f6';
  if (['xls','xlsx'].includes(ext||'')) return '#22c55e';
  return '#8b5cf6';
}
---

<Layout title="Dokumenty — WW-CB">
  <h2 class="section-title" data-i18n="docs.title">Oficiální dokumenty</h2>

  {docs.length > 0 ? (
    <div class="card" style="padding:0;overflow:hidden;">
      {docs.map((doc, i) => (
        <a
          href={doc.data.file}
          download
          target="_blank"
          rel="noopener"
          style={`display:flex;align-items:center;gap:16px;padding:16px 20px;text-decoration:none;color:inherit;border-bottom:${i < docs.length - 1 ? '1px solid rgba(128,128,128,0.1)' : 'none'};transition:background .15s;`}
          onmouseover="this.style.background='rgba(128,128,128,0.06)'"
          onmouseout="this.style.background=''"
        >
          <!-- Ikona typu souboru -->
          <div style={`flex-shrink:0;width:44px;height:44px;border-radius:8px;background:${getColor(doc.data.file)}18;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:${getColor(doc.data.file)};letter-spacing:.03em;`}>
            {getIcon(doc.data.file)}
          </div>

          <!-- Info -->
          <div style="flex:1;min-width:0;">
            <div style="font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
              {doc.data.title}
            </div>
            {doc.data.description && (
              <div style="font-size:13px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                {doc.data.description}
              </div>
            )}
          </div>

          <!-- Velikost + download šipka -->
          <div style="flex-shrink:0;display:flex;align-items:center;gap:12px;">
            {doc.data.size && (
              <span style="font-size:12px;color:var(--muted);">{doc.data.size}</span>
            )}
            <div style="width:32px;height:32px;border-radius:6px;background:rgba(128,128,128,0.08);display:flex;align-items:center;justify-content:center;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--muted)">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="card" style="text-align:center;padding:60px 20px;color:var(--muted);">
      <p style="margin:0;font-size:16px;">Zatím žádné dokumenty.</p>
      <p style="margin:12px 0 0;font-size:13px;">Dokumenty se přidávají v administraci.</p>
    </div>
  )}
</Layout>
